PORT=3001
NODE_ENV=development
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here
PAYSTACK_MODE=test
PUBLIC_APP_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_TTL_MS=86400000
DATABASE_URL=
DATABASE_URL_POOLED=
# DATABASE_URL is the direct (unpooled) URL for schema changes and seed tasks.
# DATABASE_URL_POOLED is the pooled URL (hostname includes "-pooler") for app queries.

# Optional, migration-only connection settings for the legacy Neon-to-MySQL copy.
NEON_SOURCE_DATABASE_URL=
# Set these from Namecheap's cPanel/server details. Do not guess the hostname.
NAMECHEAP_DB_HOST=
NAMECHEAP_DB_PORT=3306
NAMECHEAP_DB_NAME=cjgiwmmk_cjgifts
NAMECHEAP_DB_USER=
NAMECHEAP_DB_PASSWORD=
# Leave both confirmation gates unset unless separately approved:
# CJGIFTS_SCHEMA_CREATE_CONFIRM=CREATE_SCHEMA_ON_VERIFIED_EMPTY_NAMECHEAP_DATABASE
# CJGIFTS_MIGRATION_CONFIRM=COPY_NEON_READ_ONLY_TO_EMPTY_NAMECHEAP_TARGET
